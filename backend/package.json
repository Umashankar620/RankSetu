{
  "name": "ranksetu-backend",
  "version": "3.0.0",
  "description": "RankSetu backend — production, facets, Redis cache, eligibility API",
  "main": "server.js",
  "scripts": {
    "start":       "node server.js",
    "dev":         "nodemon server.js",
    "prod":        "NODE_ENV=production node server.js",
