  },
  "dependencies": {
    "compression":        "^1.7.4",
    "cors":               "^2.8.5",
    "dotenv":             "^16.0.3",
    "express":            "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet":             "^7.1.0",
    "ioredis":            "^5.3.2",
    "mysql2":             "^3.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
